<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>CsExcel</PackageId>
    <Version>1.0.4</Version>
    <Authors>Kookerella Ltd</Authors>
    <Company>Kookerella Ltd</Company>
    <Description>Generate Excel workbooks from C# declaratively and functionally: build a workbook as an immutable sequence of instructions, then render it, rather than mutating a workbook object cell by cell. Wraps FsExcel (via ClosedXML), with a Vanilla (static factory) and a Fluent (chainable, immutable builder) calling style.</Description>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Kookerella-Ltd/CsExcel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kookerella-Ltd/CsExcel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csexcel;excel;xlsx;spreadsheet;functional;declarative;csharp;dotnet;workbook;immutable;fsexcel;closedxml;reporting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Vanilla.fs" />
    <Compile Include="Fluent.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsExcel" Version="0.0.49" />
    <PackageReference Update="FSharp.Core" Version="10.1.400" />
    <PackageReference Include="System.IO.Packaging" Version="6.0.1" />
    <PackageReference Include="Microsoft.NETCore.Platforms" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
